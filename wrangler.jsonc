{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afterlight-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/story/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PROVIDER_MODE": "fixture",
    "PUBLIC_ORIGIN": "http://127.0.0.1:5178",
    "ALLOW_DEV_LOGIN": "true",
    "PAYMENTS_ENABLED": "false",
    "DIRECTOR_API_URL": "https://api.deepseek.com/chat/completions",
    "DIRECTOR_MODEL": "deepseek-v4-flash",
    "FAL_MODEL": "minimax/h3-max-turbo/text-to-video",
    "STREAM_ACCOUNT_ID": "",
    "SUPPORT_EMAIL": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afterlight-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "afterlight-local-media",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STORY_ROOMS",
        "class_name": "StoryRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StoryRoom"],
    },
  ],
  "workflows": [
    {
      "binding": "GENERATION",
      "name": "afterlight-local-generation",
      "class_name": "GenerationWorkflow",
    },
    {
      "binding": "ARCHIVES",
      "name": "afterlight-local-archives",
      "class_name": "ArchiveWorkflow",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "env": {
    "staging": {
      "name": "afterlight-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "PROVIDER_MODE": "disabled",
        "PUBLIC_ORIGIN": "https://configure-staging.example",
        "ALLOW_DEV_LOGIN": "false",
        "PAYMENTS_ENABLED": "false",
        "DIRECTOR_API_URL": "https://api.deepseek.com/chat/completions",
        "DIRECTOR_MODEL": "deepseek-v4-flash",
        "FAL_MODEL": "minimax/h3-max-turbo/text-to-video",
        "STREAM_ACCOUNT_ID": "",
        "SUPPORT_EMAIL": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "afterlight-staging",
          "database_id": "REPLACE_STAGING_DATABASE_ID",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "afterlight-staging-media",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "STORY_ROOMS",
            "class_name": "StoryRoom",
          },
        ],
      },
      "workflows": [
        {
          "binding": "GENERATION",
          "name": "afterlight-staging-generation",
          "class_name": "GenerationWorkflow",
        },
        {
          "binding": "ARCHIVES",
          "name": "afterlight-staging-archives",
          "class_name": "ArchiveWorkflow",
        },
      ],
    },
    "production": {
      "name": "afterlight-production",
      "vars": {
        "ENVIRONMENT": "production",
        "PROVIDER_MODE": "disabled",
        "PUBLIC_ORIGIN": "https://configure-production.example",
        "ALLOW_DEV_LOGIN": "false",
        "PAYMENTS_ENABLED": "false",
        "DIRECTOR_API_URL": "https://api.deepseek.com/chat/completions",
        "DIRECTOR_MODEL": "deepseek-v4-flash",
        "FAL_MODEL": "minimax/h3-max-turbo/text-to-video",
        "STREAM_ACCOUNT_ID": "",
        "SUPPORT_EMAIL": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "afterlight-production",
          "database_id": "REPLACE_PRODUCTION_DATABASE_ID",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "afterlight-production-media",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "STORY_ROOMS",
            "class_name": "StoryRoom",
          },
        ],
      },
      "workflows": [
        {
          "binding": "GENERATION",
          "name": "afterlight-production-generation",
          "class_name": "GenerationWorkflow",
        },
        {
          "binding": "ARCHIVES",
          "name": "afterlight-production-archives",
          "class_name": "ArchiveWorkflow",
        },
      ],
    },
  },
}
