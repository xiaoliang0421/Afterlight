{
  "name": "afterlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8788",
    "build": "vite build",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file fixtures/seed.sql",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node --import tsx --test tests/integration/*.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:check": "node scripts/preflight.mjs",
    "deploy:staging": "npm run deploy:check -- staging && npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run deploy:check -- production && npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "better-auth": "^1.7.3",
    "hls.js": "^1.7.2",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
